     "suppresses": [
      "H1",
      "H2"
     ]
    },
    "H1": {
     "min_frac_of_grid": 0.8,
     "min_stable_twins": 6,
     "n_stable_within": 2
    },
    "H2": {
     "min_ablation_jaccard": 0.5,
     "min_climb_ranks": 20,
     "top_climber_min_frac_of_grid": 0.8
    },
    "H3": {
     "descriptive_only": true,
     "numbers": "CES SM published cells",
     "wording": "each axis's rank, never a superlative: the rules_version 1 'led all {N} metros on both' claims more than either source shows (FLAGSHIP.md HEADLINES). Narrowed in rules_version 4 to permit exactly one gated statement, the H3b clause"
    },
    "H3b": {
     "added": "rules_version 4, after the raw CES results were known, as the source choice was (docs/DECISIONS.md); it mirrors the viral chart Cam asked to reproduce",
     "chart_title": {
      "ladder": [
       "No Major Metro Beat {subject} on Both Office-Industry and Goods-and-Logistics Job Growth, {t0} to {t1}",
       "No Major Metro Beat {subject} on Both Office and Goods-and-Logistics Job Growth, {t0} to {t1}"
      ],
      "rule": "when the H3b clause prints, the chart title is the first rung that fits every canvas that draws a headline at the smallest size on its ladder (Atlas canvas.ts headlineMisfits); no rung fitting is an export error. Otherwise the neutral title"
     },
     "clause": "no major metro beat {subject} on both",
     "extends": "H3",
     "fail": "closed: a failing or unevaluable precondition suppresses the clause, and the evidence names each failing row",
     "gating_rows": [
      "E1",
      "E2",
      "E3",
      "D1",
      "D2",
      "D3",
      "P1",
      "P2",
      "P3"
     ],
     "kind": "descriptive dominance statement: no publishable major metro has a strictly larger growth than the subject on both axes",
     "never": [
      "fastest",
      "only",
      "a twin claim"
     ],
     "preconditions": {
      "a": "main specification: zero publishable metros have office > subject and goods > subject (strictly larger growth on both axes)",
      "b": "the same holds in every gating row; each gating row id is present and evaluated, and a missing or unevaluated row fails the gate",
      "c": "in the main specification and in every gating row, each metro that is not publishable is checked on the axes it has: it fails the gate if it has no axis, or if it beats the subject on every axis it has (so beating it on both is possible)",
      "d": "the subject is publishable in the main specification",
      "recency": "the recency caveat (row R, 2022->2025: the subject's two ranks and the metros that beat it on both there) prints with the clause; the caveat needs a non-empty list of those metros, and if it can't print the clause is suppressed"
     }
    }
   },
